{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Cost and token usage across agents and models",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": null,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }, "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Total Cost",
      "type": "stat",
      "targets": [
        { "datasource": null, "expr": "sum(agentctl_cost_estimate_dollars{agent=~\"$agent\",instance=~\"$instance\"})", "legendFormat": "total", "refId": "A" }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "pieType": "pie", "tooltip": { "mode": "single" } },
      "title": "Cost by Model",
      "type": "piechart",
      "targets": [
        { "datasource": null, "expr": "sum by (model) (agentctl_cost_estimate_dollars{agent=~\"$agent\",instance=~\"$instance\"})", "legendFormat": "{{model}}", "refId": "A" }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1, "stacking": { "group": "A", "mode": "normal" } }, "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 0 },
      "id": 3,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Cost Over Time by Agent",
      "type": "timeseries",
      "targets": [
        { "datasource": null, "expr": "agentctl_cost_estimate_dollars{agent=~\"$agent\",instance=~\"$instance\"}", "legendFormat": "{{agent}}", "refId": "A" }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "barRadius": 0.1, "groupWidth": 0.7, "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "orientation": "horizontal", "tooltip": { "mode": "single" } },
      "title": "Token Usage by Model",
      "type": "barchart",
      "targets": [
        { "datasource": null, "expr": "sum by (model, direction) (agentctl_tokens_total{agent=~\"$agent\",model=~\"$model\",instance=~\"$instance\"})", "legendFormat": "{{model}} {{direction}}", "refId": "A" }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "max": 1, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "green", "value": 0.6 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "id": 5,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "Cache Hit Rate",
      "type": "gauge",
      "targets": [
        {
          "datasource": null,
          "expr": "sum(agentctl_tokens_total{direction=\"cache_read\",agent=~\"$agent\",model=~\"$model\",instance=~\"$instance\"}) / (sum(agentctl_tokens_total{direction=\"input\",agent=~\"$agent\",model=~\"$model\",instance=~\"$instance\"}) + sum(agentctl_tokens_total{direction=\"cache_read\",agent=~\"$agent\",model=~\"$model\",instance=~\"$instance\"}) + sum(agentctl_tokens_total{direction=\"cache_create\",agent=~\"$agent\",model=~\"$model\",instance=~\"$instance\"}))",
          "legendFormat": "cache hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1 }, "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "id": 6,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Daily Cost Trend",
      "type": "timeseries",
      "targets": [
        { "datasource": null, "expr": "increase(agentctl_cost_estimate_dollars{agent=~\"$agent\",instance=~\"$instance\"}[1d])", "legendFormat": "{{agent}}", "refId": "A" }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["agentctl"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": null,
        "definition": "label_values(agentctl_agents_active, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "options": [],
        "query": { "query": "label_values(agentctl_agents_active, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {},
        "datasource": null,
        "definition": "label_values(agentctl_agents_active, agent)",
        "hide": 0,
        "includeAll": true,
        "label": "Agent",
        "multi": false,
        "name": "agent",
        "options": [],
        "query": { "query": "label_values(agentctl_agents_active, agent)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {},
        "datasource": null,
        "definition": "label_values(agentctl_tokens_total, model)",
        "hide": 0,
        "includeAll": true,
        "label": "Model",
        "multi": false,
        "name": "model",
        "options": [],
        "query": { "query": "label_values(agentctl_tokens_total, model)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Cost & Usage",
  "uid": "agentctl-cost-usage",
  "version": 1
}
