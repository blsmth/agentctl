{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Fleet-level overview of all agentctl agents",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": null,
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "title": "Active Agents",
      "type": "stat",
      "targets": [
        { "datasource": null, "expr": "sum(agentctl_agents_active)", "legendFormat": "active", "refId": "A" }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Token Burn Rate",
      "type": "timeseries",
      "targets": [
        { "datasource": null, "expr": "rate(agentctl_tokens_total[5m])", "legendFormat": "{{direction}}", "refId": "A" }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 14, "y": 0 },
      "id": 3,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "pieType": "pie", "tooltip": { "mode": "single" } },
      "title": "State Distribution",
      "type": "piechart",
      "targets": [
        { "datasource": null, "expr": "agentctl_agents_active", "legendFormat": "{{state}}", "refId": "A" }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Agents Spawned Over Time",
      "type": "timeseries",
      "targets": [
        { "datasource": null, "expr": "rate(agentctl_agents_spawned_total[$__rate_interval])", "legendFormat": "spawned/s", "refId": "A" }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": { "bucketSize": "auto", "fillOpacity": 80, "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "title": "Session Duration Distribution",
      "type": "histogram",
      "targets": [
        { "datasource": null, "expr": "agentctl_session_duration_seconds_bucket", "legendFormat": "{{le}}", "refId": "A" }
      ]
    },
    {
      "datasource": null,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1 }, "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 6,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Estimated Cost Accumulating",
      "type": "timeseries",
      "targets": [
        { "datasource": null, "expr": "agentctl_cost_estimate_dollars", "legendFormat": "{{agent}}", "refId": "A" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["agentctl"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": null,
        "definition": "label_values(agentctl_agents_active, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "options": [],
        "query": { "query": "label_values(agentctl_agents_active, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "5m", "value": "5m" },
        "hide": 0,
        "includeAll": false,
        "label": "Interval",
        "multi": false,
        "name": "interval",
        "options": [
          { "selected": false, "text": "1m", "value": "1m" },
          { "selected": true,  "text": "5m", "value": "5m" },
          { "selected": false, "text": "15m", "value": "15m" },
          { "selected": false, "text": "1h", "value": "1h" }
        ],
        "query": "1m,5m,15m,1h",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fleet Overview",
  "uid": "agentctl-fleet-overview",
  "version": 1
}
