{
  "comment": "Shared by Go (internal/tui TestTreeRows) and JS (internal/serve/web/logic.js treeRows). Rows are given in arbitrary order; both sides first sort by attention (state rank, then index). want entries are in display order: {label} for a bucket header, else {id, depth, prefix}. scheduled_by marks a window agentctl cron launched.",
  "cases": [
    {"name": "no dispatched",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "", "dispatched": false, "state": "idle", "index": 1}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"id": "@2", "depth": 0, "prefix": ""}]},
    {"name": "two children",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "@1", "dispatched": true, "state": "idle", "index": 1},
              {"window_id": "@3", "parent": "@1", "dispatched": true, "state": "idle", "index": 2}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"id": "@2", "depth": 1, "prefix": "├─ "}, {"id": "@3", "depth": 1, "prefix": "└─ "}]},
    {"name": "grandchild continuation",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "@1", "dispatched": true, "state": "idle", "index": 1},
              {"window_id": "@3", "parent": "@2", "dispatched": true, "state": "idle", "index": 2},
              {"window_id": "@4", "parent": "@1", "dispatched": true, "state": "idle", "index": 3},
              {"window_id": "@5", "parent": "", "dispatched": false, "state": "idle", "index": 4}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"id": "@2", "depth": 1, "prefix": "├─ "}, {"id": "@3", "depth": 2, "prefix": "│  └─ "},
              {"id": "@4", "depth": 1, "prefix": "└─ "}, {"id": "@5", "depth": 0, "prefix": ""}]},
    {"name": "orphan bucket",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "@99", "dispatched": true, "state": "idle", "index": 1}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"label": "dispatched (1)"}, {"id": "@2", "depth": 1, "prefix": "└─ "}]},
    {"name": "parent in another group goes to bucket",
     "rows": [{"window_id": "@7", "parent": "@3-other-group", "dispatched": true, "state": "blocked", "index": 0},
              {"window_id": "@8", "parent": "", "dispatched": false, "state": "working", "index": 1}],
     "want": [{"id": "@8", "depth": 0, "prefix": ""}, {"label": "dispatched (1)"}, {"id": "@7", "depth": 1, "prefix": "└─ "}]},
    {"name": "untrusted parent",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "", "dispatched": true, "state": "idle", "index": 1},
              {"window_id": "@3", "parent": "", "dispatched": true, "state": "idle", "index": 2}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"label": "dispatched (2)"}, {"id": "@2", "depth": 1, "prefix": "├─ "}, {"id": "@3", "depth": 1, "prefix": "└─ "}]},
    {"name": "orphan with child",
     "rows": [{"window_id": "@2", "parent": "@99", "dispatched": true, "state": "idle", "index": 0},
              {"window_id": "@3", "parent": "@2", "dispatched": true, "state": "idle", "index": 1}],
     "want": [{"label": "dispatched (2)"}, {"id": "@2", "depth": 1, "prefix": "└─ "}, {"id": "@3", "depth": 2, "prefix": "   └─ "}]},
    {"name": "cycle",
     "rows": [{"window_id": "@1", "parent": "@2", "dispatched": true, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "@1", "dispatched": true, "state": "idle", "index": 1}],
     "want": [{"label": "dispatched (2)"}, {"id": "@1", "depth": 1, "prefix": "└─ "}, {"id": "@2", "depth": 2, "prefix": "   └─ "}]},
    {"name": "cycle alongside a root",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "@3", "dispatched": true, "state": "idle", "index": 1},
              {"window_id": "@3", "parent": "@2", "dispatched": true, "state": "idle", "index": 2}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"label": "dispatched (2)"}, {"id": "@2", "depth": 1, "prefix": "└─ "}, {"id": "@3", "depth": 2, "prefix": "   └─ "}]},
    {"name": "self parent",
     "rows": [{"window_id": "@1", "parent": "@1", "dispatched": true, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "", "dispatched": false, "state": "idle", "index": 1}],
     "want": [{"id": "@2", "depth": 0, "prefix": ""}, {"label": "dispatched (1)"}, {"id": "@1", "depth": 1, "prefix": "└─ "}]},
    {"name": "children sorted by attention",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "@1", "dispatched": true, "state": "idle", "index": 1},
              {"window_id": "@3", "parent": "@1", "dispatched": true, "state": "blocked", "index": 2},
              {"window_id": "@4", "parent": "@1", "dispatched": true, "state": "working", "index": 3}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"id": "@3", "depth": 1, "prefix": "├─ "}, {"id": "@4", "depth": 1, "prefix": "├─ "}, {"id": "@2", "depth": 1, "prefix": "└─ "}]},
    {"name": "scheduled bucket after dispatched",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "", "dispatched": true, "state": "idle", "index": 1},
              {"window_id": "@3", "parent": "", "dispatched": true, "scheduled_by": "nightly-triage", "state": "working", "index": 2},
              {"window_id": "@4", "parent": "", "dispatched": true, "scheduled_by": "weekly-deps", "state": "idle", "index": 3}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"label": "dispatched (1)"}, {"id": "@2", "depth": 1, "prefix": "└─ "},
              {"label": "scheduled (2)"}, {"id": "@3", "depth": 1, "prefix": "├─ "}, {"id": "@4", "depth": 1, "prefix": "└─ "}]},
    {"name": "scheduled alone",
     "rows": [{"window_id": "@5", "parent": "", "dispatched": true, "scheduled_by": "nightly-triage", "state": "idle", "index": 0}],
     "want": [{"label": "scheduled (1)"}, {"id": "@5", "depth": 1, "prefix": "└─ "}]},
    {"name": "scheduled with child keeps its subtree",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": true, "scheduled_by": "nightly-triage", "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "@1", "dispatched": true, "state": "idle", "index": 1}],
     "want": [{"label": "scheduled (2)"}, {"id": "@1", "depth": 1, "prefix": "└─ "}, {"id": "@2", "depth": 2, "prefix": "   └─ "}]},
    {"name": "detached cron window goes to scheduled, detached phone window is a root",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": true, "detached": true, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "", "dispatched": true, "detached": true, "scheduled_by": "nightly-triage", "state": "idle", "index": 1}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"label": "scheduled (1)"}, {"id": "@2", "depth": 1, "prefix": "└─ "}]},
    {"name": "roots sorted by attention",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "", "dispatched": false, "state": "blocked", "index": 1}],
     "want": [{"id": "@2", "depth": 0, "prefix": ""}, {"id": "@1", "depth": 0, "prefix": ""}]},
    {"name": "detached dispatched is a root beside bare sessions",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "", "dispatched": true, "detached": true, "state": "idle", "index": 1}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"id": "@2", "depth": 0, "prefix": ""}]},
    {"name": "dispatched with absent recorded parent stays in bucket",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "@9", "dispatched": true, "state": "idle", "index": 1}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"label": "dispatched (1)"}, {"id": "@2", "depth": 1, "prefix": "└─ "}]},
    {"name": "detached with in-group parent still nests",
     "rows": [{"window_id": "@1", "parent": "", "dispatched": false, "state": "idle", "index": 0},
              {"window_id": "@2", "parent": "@1", "dispatched": true, "detached": true, "state": "idle", "index": 1}],
     "want": [{"id": "@1", "depth": 0, "prefix": ""}, {"id": "@2", "depth": 1, "prefix": "└─ "}]}
  ]
}
