{
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "agentctl hook-config-change",
            "type": "command"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agentctl hook-cwd-changed",
            "type": "command"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "command": "agentctl hook-elicitation",
            "type": "command"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "command": "agentctl hook-elicitation-result",
            "type": "command"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agentctl hook-file-changed",
            "type": "command"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agentctl hook-instructions-loaded",
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agentctl hook-notify",
            "type": "command"
          }
        ],
        "matcher": "idle_prompt|permission_prompt"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "agentctl hook-permission-request",
            "type": "command"
          }
        ],
        "matcher": "Write"
      },
      {
        "hooks": [
          {
            "command": "agentctl hook-permission-request",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "agentctl hook-post-compact",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "agentctl hook-post-tool",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "agentctl hook-post-tool-failure",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "agentctl hook-pre-compact",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "agentctl hook-pre-tool",
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "agentctl hook-validate-bash",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agentctl hook-session-end",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "agentctl hook-session-start",
            "type": "command"
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "command": "agentctl hook-setup",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "agentctl hook-check-done",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "agentctl hook-stop-failure",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agentctl hook-subagent-start",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "agentctl hook-subagent-stop",
            "type": "command"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "agentctl hook-task-completed",
            "type": "command"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "command": "agentctl hook-task-created",
            "type": "command"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "command": "agentctl hook-teammate-idle",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "agentctl hook-user-prompt",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "agentctl hook-worktree-create",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "async": true,
            "command": "agentctl hook-worktree-remove",
            "type": "command"
          }
        ]
      }
    ]
  }
}
